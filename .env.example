# =====================
# OpenMeta 环境变量模板
# =====================
# 说明：
# - 本地开发 / Docker：复制为 .env 后修改
# - Vercel：在 Dashboard -> Project -> Settings -> Environment Variables 中配置

# ---------------------
# PanSou 配置（可选）
# ---------------------
# 不配置 PANSOU_HOST 时，后端会返回空结果（用于快速跑通 UI）。
# 示例：PANSOU_HOST=http://127.0.0.1:8888
PANSOU_HOST=
PANSOU_USER=
PANSOU_PWD=

# ---------------------
# Redis 配置（可选）
# ---------------------
# 如启用 docker-compose-prod.yml 的 redis profile，建议：REDIS_HOST=redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------
# 后端监听（本地脚本用）
# ---------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------
# 运行参数
# ---------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 每 IP 每分钟请求数（可选）
RATE_LIMIT_PER_MINUTE=10

# 请求 PanSou 的超时（秒）
SEARCH_TIMEOUT=15

# 允许跨域来源（逗号分隔）。本地开发建议：http://localhost:5173
# 生产（Docker/Vercel）如前后端同域名，可填 * 或留默认。
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------------------
# 高级：覆盖后端入口（一般不需要）
# ---------------------
# APP_MODULE=backend.app.main:app
