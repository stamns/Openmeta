# PanSou 配置（必填）
PANSOU_HOST=http://112.124.53.114:8888
PANSOU_USER=admin
PANSOU_PWD=your-password-here

# Redis 配置（可选，用于缓存/限流；不配置则使用内存模式）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 服务监听
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 速率限制（每个 IP 每分钟请求数）
RATE_LIMIT_PER_MINUTE=10

# 搜索超时（秒）
SEARCH_TIMEOUT=15

# CORS 允许来源（逗号分隔；生产建议填写你的域名）
CORS_ALLOW_ORIGINS=http://localhost:5173
