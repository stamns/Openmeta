{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "backend/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api(?:/(.*))?",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/(.*\\.(js|css|html))",
      "dest": "backend/public/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "backend/public/index.html"
    }
  ],
  "env": {
    "PANSOU_HOST": "@pansou_host",
    "PANSOU_USER": "@pansou_user",
    "PANSOU_PWD": "@pansou_pwd"
  }
}
