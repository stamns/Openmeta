# OpenMeta 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# === PanSou 搜索服务配置 ===
# PanSou 服务器地址 (必需)
PANSOU_HOST=http://112.124.53.114:8888

# PanSou 认证信息 (可选)
PANSOU_USER=admin
PANSOU_PWD=

# === Vercel 部署配置 ===
# 如果在 Vercel 环境中，这些环境变量需要通过 Vercel Dashboard 设置
# Vercel 环境变量设置:
# 1. 登录 Vercel Dashboard
# 2. 选择你的项目
# 3. 进入 Settings -> Environment Variables
# 4. 添加以下变量:
#    - PANSOU_HOST
#    - PANSOU_USER 
#    - PANSOU_PWD

# === 开发环境配置 ===
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 搜索超时时间 (秒)
SEARCH_TIMEOUT=15

# 速率限制 (每分钟请求数)
RATE_LIMIT_PER_MINUTE=10

# === CORS 配置 ===
# 允许的源地址，逗号分隔，* 表示允许所有源
CORS_ALLOW_ORIGINS=*

# === Redis 配置 (可选) ===
# 如果需要缓存功能
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=